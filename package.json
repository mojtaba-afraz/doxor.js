{
  "name": "doxor.js",
  "version": "2.0.1",
  "description": "Tiny, typed, Promise-based collections for IndexedDB",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "playground": "vite playground",
    "build:playground": "vite build playground",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project \"browser*\"",
    "check:pkg": "publint --strict && attw --pack . --profile esm-only",
    "size": "size-limit",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && vite build playground --outDir ../docs/.vitepress/dist/playground --emptyOutDir",
    "docs:preview": "vitepress preview docs"
  },
  "size-limit": [
    {
      "name": "ESM",
      "path": "dist/index.js",
      "limit": "4.9 kB"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojtaba-afraz/doxor.js.git"
  },
  "keywords": [
    "indexeddb",
    "idb",
    "browser",
    "database",
    "storage",
    "offline",
    "typescript"
  ],
  "author": "Mojtaba Afraz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mojtaba-afraz/doxor.js/issues"
  },
  "homepage": "https://github.com/mojtaba-afraz/doxor.js#readme",
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.19.0 || ^24.11.0 || >=26.0.0",
      "onFail": "warn"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@shikijs/vitepress-twoslash": "~4.4.3",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "size-limit": "^14.1.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@~6.0.3",
    "vite": "^8.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@shikijs/twoslash": "2.5.0"
  }
}
